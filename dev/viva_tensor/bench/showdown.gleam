//// Side-by-side showdown: viva_tensor (all backends) vs PyTorch vs NumPy.
////
//// Reads PyTorch/NumPy results from `bench/results/pytorch_results.term`
//// (generated by `python bench/python/compare/numpy_pytorch.py`) and benchmarks
//// the same shapes through every viva_tensor path the NIF exposes.
////
//// Output: a markdown-ish table grouped by shape, sorted by TFLOPS,
//// with the winner per shape highlighted.
////
//// Run: gleam run -m viva_tensor/bench/showdown

import gleam/float
import gleam/int
import gleam/io
import gleam/list
import gleam/order
import gleam/string

pub fn main() {
  io.println(
    "\n╔══════════════════════════════════════════════════════════════════╗",
  )
  io.println(
    "║   SHOWDOWN: viva_tensor vs PyTorch vs NumPy — RTX 4090 + 24-core ║",
  )
  io.println(
    "╚══════════════════════════════════════════════════════════════════╝\n",
  )

  let _ = is_loaded()

  let shapes = [2048, 4096]
  let iters = 30

  let pytorch_entries = case read_pytorch_results() {
    Ok(entries) -> {
      io.println(
        "PyTorch reference: "
        <> int.to_string(list.length(entries))
        <> " entries from bench/results/pytorch_results.term\n",
      )
      entries
    }
    Error(reason) -> {
      io.println(
        "WARN: no PyTorch results (" <> reason <> "). Viva-only mode.\n",
      )
      []
    }
  }

  list.each(shapes, fn(n) {
    io.println(
      "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
    )
    io.println("  " <> int.to_string(n) <> " × " <> int.to_string(n) <> " GEMM")
    io.println(
      "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
    )
    io.println(
      "    backend                                        TFLOPS    ms/iter",
    )
    io.println(
      "    ────────────────────────────────────────────  ────────  ─────────",
    )

    let viva_rows = collect_viva_rows(n, iters)
    let pytorch_rows =
      pytorch_entries
      |> list.filter(fn(triple) {
        let #(_, en, _, _) = triple
        en == n
      })
      |> list.map(fn(triple) {
        let #(p, _, t, m) = triple
        #(label_pytorch(p), t, m)
      })

    let all_rows =
      list.append(viva_rows, pytorch_rows)
      |> list.sort(fn(a, b) {
        let #(_, ta, _) = a
        let #(_, tb, _) = b
        case tb >. ta {
          True -> order.Gt
          False -> order.Lt
        }
      })

    let best_tflops = case all_rows {
      [#(_, t, _), ..] -> t
      _ -> 0.0
    }

    list.each(all_rows, fn(triple) {
      let #(label, tflops, ms) = triple
      let marker = case tflops == best_tflops {
        True -> " 🏆"
        False -> "   "
      }
      io.println(
        marker
        <> " "
        <> pad_right(label, 44)
        <> "  "
        <> pad_left(float.to_string(round1(tflops)), 7)
        <> "   "
        <> pad_left(float.to_string(round2(ms)), 6),
      )
    })
    io.println("")
  })

  io.println(
    "Notes: viva_tensor numbers are kernel-only (cudaEvent); PyTorch and",
  )
  io.println("       NumPy numbers are wall-clock (perf_counter / cudaEvent).")
  io.println(
    "       viva CUTLASS paths bypass the GeForce FP32-accum cap that limits",
  )
  io.println("       PyTorch's _scaled_mm to ~330 TFLOPS on Ada SM89.")
}

// =============================================================================
// Bench every viva_tensor path for shape `n`
// =============================================================================

fn collect_viva_rows(n: Int, iters: Int) -> List(#(String, Float, Float)) {
  let flops = 2.0 *. int.to_float(n * n * n * iters)
  [
    run_us("viva MKL CPU FP32 dense              ", flops, iters, fn() {
      mkl_dgemm_bench(n, n, n, iters)
    }),
    run_us("viva cublasLt FP16 (heur)            ", flops, iters, fn() {
      cublaslt_fp16_bench(n, n, n, iters)
    }),
    run_us("viva cublasLt FP16 algo-sweep        ", flops, iters, fn() {
      cublaslt_fp16_algo_sweep(n, n, n, iters, 16)
    }),
    run_us("viva cublasLt FP16+RELU+BIAS fused   ", flops, iters, fn() {
      cublaslt_fp16_fused_bench(n, n, n, iters, 6)
    }),
    run_us("viva cublasLt FP16+GELU+BIAS fused   ", flops, iters, fn() {
      cublaslt_fp16_fused_bench(n, n, n, iters, 36)
    }),
    run_us("viva CUTLASS FP8 + FP16 accum        ", flops, iters, fn() {
      cutlass_fp8_bench(n, n, n, iters, 0)
    }),
    run_us("viva cublasLt FP8 algo-sweep         ", flops, iters, fn() {
      cublaslt_fp8_algo_sweep(n, n, n, iters, 16)
    }),
    run_us("viva cuSPARSELt FP16 2:4 sparse      ", flops, iters, fn() {
      cusparselt_fp16_sparse_bench(n, n, n, iters)
    }),
    run_us("viva cuSPARSELt FP8 2:4 sparse       ", flops, iters, fn() {
      cusparselt_fp8_sparse_bench(n, n, n, iters)
    }),
    run_us("viva cuSPARSELt INT8 2:4 sparse      ", flops, iters, fn() {
      cusparselt_int8_sparse_bench(n, n, n, iters, 0)
    }),
    run_us("viva CUTLASS INT8 2:4 cfg=28         ", flops, iters, fn() {
      cutlass_int8_sparse_bench_ex(n, n, n, iters, 28, 1)
    }),
    run_us("viva CUTLASS INT4 2:4 cfg=28         ", flops, iters, fn() {
      cutlass_int4_sparse_bench(n, n, n, iters, 28, 1)
    }),
  ]
  |> list.filter_map(fn(x) { x })
}

fn run_us(
  label: String,
  flops: Float,
  iters: Int,
  call: fn() -> Result(Int, String),
) -> Result(#(String, Float, Float), Nil) {
  case call() {
    Ok(us) if us > 0 -> {
      let tflops = flops /. int.to_float(us) /. 1.0e6
      let ms = int.to_float(us) /. int.to_float(iters) /. 1000.0
      Ok(#(label, tflops, ms))
    }
    _ -> Error(Nil)
  }
}

// =============================================================================
// MKL CPU FP32 bench via existing NIF (cuda_gemm.c calls cblas_dgemm directly)
// =============================================================================

fn mkl_dgemm_bench(
  _m: Int,
  _n: Int,
  _k: Int,
  _iters: Int,
) -> Result(Int, String) {
  // viva_tensor doesn't expose a self-contained MKL DGEMM bench yet; the
  // best proxy is the cublaslt_fp16_bench wall-clock minus GPU sync, but
  // that's apples-to-oranges. Skip MKL CPU row in showdown for now.
  Error("mkl_bench_not_exposed_as_nif")
}

// =============================================================================
// Read PyTorch results from term file
// =============================================================================

fn read_pytorch_results() -> Result(List(#(String, Int, Float, Float)), String) {
  case read_file("bench/results/pytorch_results.term") {
    Ok(contents) -> {
      let lines = string.split(contents, on: "\n")
      let entries =
        list.filter_map(lines, fn(line) {
          let trimmed = string.trim(line)
          case string.is_empty(trimmed) {
            True -> Error(Nil)
            False -> parse_term(trimmed)
          }
        })
      Ok(entries)
    }
    Error(reason) -> Error(reason)
  }
}

// Parse one line like: {"torch_gpu_fp16", 4096, 148.90, 0.9200}.
fn parse_term(line: String) -> Result(#(String, Int, Float, Float), Nil) {
  // Strip the trailing "}." then unwrap the surrounding "{...}" and quotes.
  let stripped =
    line
    |> string.trim
    |> trim_trailing_period
    |> string.replace(each: "{", with: "")
    |> string.replace(each: "}", with: "")
    |> string.replace(each: "\"", with: "")
  let parts = string.split(stripped, on: ", ")
  case parts {
    [path, n_str, tflops_str, ms_str] ->
      case int.parse(string.trim(n_str)) {
        Ok(n) ->
          case
            float.parse(string.trim(tflops_str)),
            float.parse(string.trim(ms_str))
          {
            Ok(t), Ok(m) -> Ok(#(string.trim(path), n, t, m))
            _, _ -> Error(Nil)
          }
        Error(_) -> Error(Nil)
      }
    _ -> Error(Nil)
  }
}

fn trim_trailing_period(s: String) -> String {
  case string.ends_with(s, ".") {
    True -> string.drop_end(s, 1)
    False -> s
  }
}

fn label_pytorch(key: String) -> String {
  case key {
    "numpy_cpu_fp32" -> "NumPy CPU FP32                       "
    "torch_cpu_fp32" -> "PyTorch CPU FP32 (oneDNN+MKL)        "
    "torch_gpu_fp32" -> "PyTorch GPU FP32 (cuBLAS)            "
    "torch_gpu_fp16" -> "PyTorch GPU FP16 (cuBLAS)            "
    "torch_gpu_bf16" -> "PyTorch GPU BF16 (cuBLAS)            "
    "torch_gpu_fp8" -> "PyTorch GPU FP8 (_scaled_mm)         "
    other -> other
  }
}

fn round1(x: Float) -> Float {
  float.to_precision(x, 1)
}

fn round2(x: Float) -> Float {
  float.to_precision(x, 2)
}

fn pad_left(s: String, n: Int) -> String {
  let len = string.length(s)
  case len >= n {
    True -> s
    False -> repeat(" ", n - len) <> s
  }
}

fn pad_right(s: String, n: Int) -> String {
  let len = string.length(s)
  case len >= n {
    True -> s
    False -> s <> repeat(" ", n - len)
  }
}

fn repeat(s: String, n: Int) -> String {
  case n <= 0 {
    True -> ""
    False -> s <> repeat(s, n - 1)
  }
}

