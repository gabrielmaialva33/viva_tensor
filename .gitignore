# =============================================================================
# viva_tensor .gitignore
# =============================================================================

# Build artifacts
*.beam
*.ez
/build
*.o

# NIF shared libraries
*.so
*.dll
*.dylib
c_src/*.o
priv/*.so
priv/*.dll

# Static archives (built from source via nvcc/ar)
*.a

# CUDA glibc compatibility fix (local workaround)
cuda_fix/
zig_src/cuda_fix/

# Zig build
zig_src/.zig-cache/
zig_src/zig-out/

# Erlang runtime
erl_crash.dump
deps/

# Benchmark outputs (generated, not committed)
bench/data/
bench/reports/
bench/test_int8_imma
bench/cuda/test_int8_imma

# Editor
.vscode/
.idea/
*.swp
*~
.*.swp

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/

# Python venv used by bench/compare/numpy_pytorch.py
.bench-venv/

# Autotune cache produced by viva_tensor/bench/cache.gleam
# (regenerate locally with `gleam run -m viva_tensor/bench/cache`)
priv/autotune_cache.term

# PyTorch results scratch file (regenerated by numpy_pytorch.py)
bench/compare/pytorch_results.term
*.pyc
*.pyo
.pytest_cache/

# Claude
.claude

# Codex
.codex

# Misc
tmp
